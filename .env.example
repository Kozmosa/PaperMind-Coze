# ====================================================================
# PaperMind — Environment Variables
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# ====================================================================

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=9091
NODE_ENV=development

# ------------------------------------------------------------------
# AI 网关（Anthropic 兼容接口，server/src/config/ai.ts 读取）
# ANTHROPIC_API_KEY 必填，否则 AI 对话 / 反思报告等接口不可用
# ------------------------------------------------------------------
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=kimi-for-coding

# ------------------------------------------------------------------
# Supabase (cloud) — server 启动必需
# Obtain from: https://supabase.com/dashboard → Project → Settings → API Keys
# 新版密钥对应关系：Publishable key → *_ANON_KEY；Secret key → *_SERVICE_ROLE_KEY
# 三组变量填同一个项目的同一套值即可
# ------------------------------------------------------------------
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# 鉴权中间件用（与上面相同的值，不填则所有请求按 guest 用户处理）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Supabase — Expo client（前端登录，EXPO_PUBLIC_ 前缀必需）
# ------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
# Backend URL for Expo client（pnpm dev 会自动注入，本地无需配置）
# ------------------------------------------------------------------
EXPO_PUBLIC_BACKEND_BASE_URL=http://localhost:9091
EXPO_PUBLIC_API_BASE=http://localhost:9091

# ------------------------------------------------------------------
# Coze platform variables (set by Coze cloud; leave empty for local dev)
# ------------------------------------------------------------------
# COZE_PROJECT_ID=
# COZE_PROJECT_NAME=PaperMind
# COZE_LOG_DIR=
# COZE_PROJECT_DOMAIN_DEFAULT=
