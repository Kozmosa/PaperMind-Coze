# ====================================================================
# PaperMind — Environment Variables
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# ====================================================================

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=9091
NODE_ENV=development

# ------------------------------------------------------------------
# AI 网关（Anthropic 兼容接口，server/src/config/ai.ts 读取）
# ANTHROPIC_API_KEY 必填，否则 AI 对话 / 反思报告等接口不可用
# ------------------------------------------------------------------
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=kimi-for-coding

# ------------------------------------------------------------------
# Embedding API（OpenAI 兼容接口，server/src/utils/embedding.ts 读取）
# 用于知识图谱检索的向量化。EMBEDDING_API_KEY 必填，否则检索链路不可用。
# 默认走 SiliconFlow 的 BAAI/bge-m3（1024 维，免费额度可用）
# ------------------------------------------------------------------
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3

# ------------------------------------------------------------------
# 视觉 OCR 兜底（扫描件 PDF 走 OpenAI 兼容端点，server/src/utils/extract-text.ts 读取）
# 不配置时回退到 ANTHROPIC_API_KEY + api.deepseek.com，与实际网关卡不匹配会静默失败，
# 结果是扫描件提取出空文本。智谱示例：BASE=https://open.bigmodel.cn/api/paas/v4
# MODEL=glm-4v-flash（免费档可用）
# ------------------------------------------------------------------
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_MODEL=glm-4v-flash
# VISION_API_KEY=

# ------------------------------------------------------------------
# Supabase (cloud) — server 启动必需
# Obtain from: https://supabase.com/dashboard → Project → Settings → API Keys
# 新版密钥对应关系：Publishable key → *_ANON_KEY；Secret key → *_SERVICE_ROLE_KEY
# 三组变量填同一个项目的同一套值即可
# ------------------------------------------------------------------
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# 鉴权中间件用（与上面相同的值，不填则所有请求按 guest 用户处理）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# 数据库迁移（可选，server/scripts/apply-migrations.ts 读取；二选一）
#   SUPABASE_ACCESS_TOKEN：个人访问令牌（推荐）— Dashboard → Account → Access Tokens 生成
#                          走 Management API 执行 SQL，无需数据库密码
#   SUPABASE_DB_URL：postgresql://postgres:<密码>@...（Project Settings → Database）
#                    pg 直连；注意直连地址仅 IPv6，本地无 IPv6 时请用 Connection pooler 的 URI
# ------------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_URL=

# ------------------------------------------------------------------
# Supabase — Expo client（前端登录，EXPO_PUBLIC_ 前缀必需）
# ------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
# Backend URL for Expo client（pnpm dev 会自动注入，本地无需配置）
# ------------------------------------------------------------------
EXPO_PUBLIC_BACKEND_BASE_URL=http://localhost:9091
EXPO_PUBLIC_API_BASE=http://localhost:9091

# ------------------------------------------------------------------
# Coze platform variables (set by Coze cloud; leave empty for local dev)
# ------------------------------------------------------------------
# COZE_PROJECT_ID=
# COZE_PROJECT_NAME=PaperMind
# COZE_LOG_DIR=
# COZE_PROJECT_DOMAIN_DEFAULT=
