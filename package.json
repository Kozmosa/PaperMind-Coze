{
  "name": "expo-express-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "bash .cozeproj/scripts/dev_run.sh",
    "build": "bash .cozeproj/scripts/prod_build.sh",
    "start": "bash .cozeproj/scripts/prod_run.sh",
    "preinstall": "npx only-allow pnpm",
    "lint:client": "npm run lint --prefix ./client",
    "lint:server": "npm run lint --prefix ./server",
    "lint:all": "npm run lint --prefix ./client; npm run lint --prefix ./server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm run --parallel '/^(lint:client|lint:server|format:check)$/'"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.2"
    },
    "patchedDependencies": {
      "expo@54.0.33": "patches/expo@54.0.33.patch"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
